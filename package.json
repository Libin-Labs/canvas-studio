{
  "name": "@lp-labs/canvas-studio",
  "version": "0.1.0",
  "description": "A small, dependency-free 2D canvas scene editor with an imperative TypeScript API.",
  "license": "MIT",
  "author": {
    "name": "Libin Prasanth",
    "url": "https://www.linkedin.com/in/libinprasanth/"
  },
  "funding": {
    "type": "paypal",
    "url": "https://www.paypal.me/LibinPrasanth"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.consumer.json",
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:dry-run": "npm pack --dry-run"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
